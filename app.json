{
  "expo": {
    "name": "Assignment_1.2-clean",
    "slug": "Assignment_1-2-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
